{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/*.js": { "includeFiles": "{public,assets,storage/uploads}/**", "maxDuration": 30 }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=api/:path*"
    },
    { "source": "/birthday/:slug", "destination": "/api/index?path=birthday/:slug" },
    { "source": "/uploads/:path*", "destination": "/api/index?path=uploads/:path*" },
    {
      "source": "/create",
      "destination": "/index.html"
    },
    {
      "source": "/edit/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/ready/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/themes",
      "destination": "/index.html"
    }
  ]
}
